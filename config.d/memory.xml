<yandex>
  <!-- Limit ClickHouse to use up to 2GB (with 3GB instance, allows for OS and container overhead) -->
  <max_server_memory_usage>2000000000</max_server_memory_usage>
  <max_server_memory_usage_to_ram_ratio>0</max_server_memory_usage_to_ram_ratio>

  <!-- Reduce cache sizes for lower memory -->
  <mark_cache_size>134217728</mark_cache_size>         <!-- 128MB -->
  <uncompressed_cache_size>67108864</uncompressed_cache_size> <!-- 64MB -->
</yandex>
